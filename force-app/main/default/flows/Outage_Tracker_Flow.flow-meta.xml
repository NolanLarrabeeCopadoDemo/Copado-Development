    <decisions>
        <name>Is_Severe_Signal</name>
        <label>Is Severe Signal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Severe</defaultConnectorLabel>
        <rules>
            <name>Poor_Or_No_Signal</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Signal_Strength_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Poor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Signal_Strength_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Signal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Followup_Task</targetReference>
            </connector>
            <label>Poor Or No Signal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Needs_Backfill</name>
        <label>Needs Backfill</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Severe_Signal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Backfill</defaultConnectorLabel>
        <rules>
            <name>Start_Or_Account_Blank</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Outage_Start__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Outage_Tracker</targetReference>
            </connector>
            <label>Start Or Account Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Task_Does_Not_Exist</name>
        <label>Task Does Not Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Task Exists</defaultConnectorLabel>
        <rules>
            <name>No_Open_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Task</leftValueReference>
