                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Followup_Task</targetReference>
            </connector>
            <label>No Open Task</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>NewAccountId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Account__c}), {!$Record.Case__r.AccountId}, {!$Record.Account__c})</expression>
    </formulas>
    <formulas>
        <name>NewOutageStart</name>
        <dataType>DateTime</dataType>
