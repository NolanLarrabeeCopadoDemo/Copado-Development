<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email_to_Reviewer</name>
        <label>Send Email Alert to Reviewer</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Create_High_Priority_Task</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Reviewed_By__r.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>QC Test Failure Alert - Immediate Action Required</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>A QC test has failed and requires immediate review and corrective action.

Test Result Number: {!$Record.Name}
Test Name: {!$Record.Test_Name__c}
Test Date/Time: {!$Record.Test_Date_Time__c}
Instrument Model: {!$Record.Instrument_Model__c}
Laboratory Location: {!$Record.Laboratory_Location__c}
Result Value: {!$Record.Result_Value__c} {!$Record.Unit_of_Measure__c}
Expected Mean: {!$Record.Expected_Mean__c}
Acceptable Range: {!$Record.Acceptable_Range_Low__c} - {!$Record.Acceptable_Range_High__c}
Westgard Rule Violation: {!$Record.Westgard_Rule_Violation__c}

Please review this failure immediately and document the corrective action taken.

Record Link: {!$Record.Id}</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Reviewer_Assigned</name>
        <label>Check if Reviewer Assigned</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No Reviewer</defaultConnectorLabel>
        <rules>
            <name>Reviewer_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Reviewed_By__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Reviewer</targetReference>
            </connector>
            <label>Reviewer Assigned</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Test_Status</name>
        <label>Check Test Status</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Test Not Failed</defaultConnectorLabel>
        <rules>
            <name>Test_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Test_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fail</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Corrective_Action_Required</targetReference>
            </connector>
            <label>Test Failed</label>
        </rules>
    </decisions>
    <description>Automatically detects when a QC test fails and triggers corrective action workflows including email alerts and task creation.</description>
    <label>QC Test Failure Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_High_Priority_Task</name>
        <label>Create High Priority Task for Supervisor</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>QC Test Failure Alert:

Test: {!$Record.Test_Name__c}
Result: {!$Record.Result_Value__c} {!$Record.Unit_of_Measure__c}
Expected: {!$Record.Expected_Mean__c}
Range: {!$Record.Acceptable_Range_Low__c} - {!$Record.Acceptable_Range_High__c}
Instrument: {!$Record.Instrument_Model__c}
Location: {!$Record.Laboratory_Location__c}
Westgard Rule: {!$Record.Westgard_Rule_Violation__c}

Immediate corrective action required. Please investigate and document resolution.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.Reviewed_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>URGENT: QC Test Failure - {!$Record.Test_Name__c}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Set_Corrective_Action_Required</name>
        <label>Set Corrective Action Required</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <connector>
            <targetReference>Check_Reviewer_Assigned</targetReference>
        </connector>
        <inputAssignments>
            <field>Corrective_Action_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Test_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Test_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Fail</stringValue>
            </value>
        </filters>
        <object>Lab_Test_Result__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
