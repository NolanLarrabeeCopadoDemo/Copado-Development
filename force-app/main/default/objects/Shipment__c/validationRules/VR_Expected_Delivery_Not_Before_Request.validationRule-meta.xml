<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Expected_Delivery_Not_Before_Request</fullName>
    <active>true</active>
    <description>Expected delivery cannot precede request date (US-0000517).</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Expected_Delivery_Date__c)), NOT(ISBLANK(Request_Date__c)), Expected_Delivery_Date__c &lt; Request_Date__c)</errorConditionFormula>
    <errorDisplayField>Expected_Delivery_Date__c</errorDisplayField>
    <errorMessage>Expected Delivery Date cannot be earlier than the Request Date.</errorMessage>
</ValidationRule>
