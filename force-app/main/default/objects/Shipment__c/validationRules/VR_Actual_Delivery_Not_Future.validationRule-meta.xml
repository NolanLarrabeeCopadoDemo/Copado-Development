<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Actual_Delivery_Not_Future</fullName>
    <active>true</active>
    <description>Actual delivery date cannot be in the future (US-0000517).</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Actual_Delivery_Date__c)), Actual_Delivery_Date__c &gt; TODAY())</errorConditionFormula>
    <errorDisplayField>Actual_Delivery_Date__c</errorDisplayField>
    <errorMessage>Actual Delivery Date cannot be in the future.</errorMessage>
</ValidationRule>
