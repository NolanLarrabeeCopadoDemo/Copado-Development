<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Review_Date_After_Test_Date</fullName>
    <active>true</active>
    <description>Ensures review date is not before test date</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Review_Date__c)),
    Review_Date__c &lt; DATEVALUE(Test_Date_Time__c)
)</errorConditionFormula>
    <errorDisplayField>Review_Date__c</errorDisplayField>
    <errorMessage>Review Date cannot be before the Test Date/Time.</errorMessage>
</ValidationRule>
