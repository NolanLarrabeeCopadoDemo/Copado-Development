<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fuel_Gallons_Used__c</fullName>
    <description>Estimated gallons of fuel consumed: Actual Mileage / Equipment Fuel Efficiency (MPG), via Shipment.Equipment.</description>
    <externalId>false</externalId>
    <formula>IF(OR(ISBLANK(Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c), Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c = 0), 0, Actual_Mileage__c / Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Fuel Gallons Used</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
