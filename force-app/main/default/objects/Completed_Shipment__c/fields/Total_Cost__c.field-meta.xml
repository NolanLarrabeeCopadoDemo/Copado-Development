<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Cost__c</fullName>
    <description>Sum of Fuel Cost, Driver Pay, Toll Costs, Miscellaneous Costs, and Maintenance Allocation.</description>
    <formula>Fuel_Cost__c + Driver_Pay__c + Toll_Costs__c + Miscellaneous_Costs__c + Maintenance_Allocation__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Cost</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
