<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fuel_Cost__c</fullName>
    <description>Estimated fuel cost: Fuel Gallons Used * Fuel Price Per Gallon.</description>
    <formula>IF(OR(ISBLANK(Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c), Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c = 0), 0, (Actual_Mileage__c / Shipment__r.Equipment__r.Fuel_Efficiency_MPG__c)) * Fuel_Price_Per_Gallon__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Fuel Cost</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
