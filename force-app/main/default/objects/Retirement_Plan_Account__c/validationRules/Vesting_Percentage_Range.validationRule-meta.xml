<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Vesting_Percentage_Range</fullName>
    <active>true</active>
    <description>Ensures vesting percentage is between 0 and 100</description>
    <errorConditionFormula>OR(
  Vesting_Percentage__c &lt; 0,
  Vesting_Percentage__c &gt; 1.0
)</errorConditionFormula>
    <errorDisplayField>Vesting_Percentage__c</errorDisplayField>
    <errorMessage>Vesting percentage must be between 0% and 100%</errorMessage>
</ValidationRule>
