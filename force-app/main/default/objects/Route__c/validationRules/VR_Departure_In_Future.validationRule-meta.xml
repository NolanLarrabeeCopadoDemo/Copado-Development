<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Departure_In_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), Departure_DateTime__c &lt; NOW())</errorConditionFormula>
    <errorMessage>Departure Date/Time must be in the future.</errorMessage>
</ValidationRule>
