<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Horsepower_Positive</fullName>
    <active>true</active>
    <description>Engine Horsepower must be greater than zero when populated.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Engine_Horsepower__c)), Engine_Horsepower__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Engine_Horsepower__c</errorDisplayField>
    <errorMessage>Engine Horsepower must be greater than zero.</errorMessage>
</ValidationRule>
