<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Purchase_Price_Positive</fullName>
    <active>true</active>
    <description>Purchase Price must be greater than zero when populated.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Purchase_Price__c)), Purchase_Price__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Purchase_Price__c</errorDisplayField>
    <errorMessage>Purchase Price must be greater than zero.</errorMessage>
</ValidationRule>
