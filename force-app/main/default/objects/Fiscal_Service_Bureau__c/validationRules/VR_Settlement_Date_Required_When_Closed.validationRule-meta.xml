<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Settlement_Date_Required_When_Closed</fullName>
    <active>true</active>
    <description>Settlement Date is required when Status is Closed.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Closed&apos;), ISBLANK(Settlement_Date__c))</errorConditionFormula>
    <errorDisplayField>Settlement_Date__c</errorDisplayField>
    <errorMessage>Settlement Date is required when Status is Closed.</errorMessage>
</ValidationRule>
