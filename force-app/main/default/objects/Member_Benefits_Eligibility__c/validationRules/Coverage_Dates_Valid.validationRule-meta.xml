<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Coverage_Dates_Valid</fullName>
    <active>true</active>
    <description>Coverage Termination Date must be after Coverage Effective Date</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Coverage_Termination_Date__c)),
    Coverage_Termination_Date__c &lt; Coverage_Effective_Date__c
)</errorConditionFormula>
    <errorDisplayField>Coverage_Termination_Date__c</errorDisplayField>
    <errorMessage>Coverage Termination Date must be after Coverage Effective Date.</errorMessage>
</ValidationRule>
