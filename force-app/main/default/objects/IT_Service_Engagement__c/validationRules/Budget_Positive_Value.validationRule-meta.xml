<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Positive_Value</fullName>
    <active>true</active>
    <description>Ensures that Budget is a positive value when populated</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Budget__c)),
    Budget__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Budget__c</errorDisplayField>
    <errorMessage>Budget must be greater than zero.</errorMessage>
</ValidationRule>
