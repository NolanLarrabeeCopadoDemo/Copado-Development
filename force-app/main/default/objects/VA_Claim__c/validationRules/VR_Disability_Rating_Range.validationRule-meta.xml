<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Disability_Rating_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Claim_Type__c, &quot;Disability&quot;), OR(ISBLANK(TEXT(Disability_Rating_Percent__c)), Disability_Rating_Percent__c &lt; 0, Disability_Rating_Percent__c &gt; 100))</errorConditionFormula>
    <errorMessage>Disability Rating Percent must be between 0 and 100 when Claim Type is Disability.</errorMessage>
</ValidationRule>
