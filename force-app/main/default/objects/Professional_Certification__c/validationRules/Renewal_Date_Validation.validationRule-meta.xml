<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Renewal_Date_Validation</fullName>
    <active>true</active>
    <description>Ensures Renewal Date is not before Issue Date</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Renewal_Date__c)),
  Renewal_Date__c &lt; Issue_Date__c
)</errorConditionFormula>
    <errorDisplayField>Renewal_Date__c</errorDisplayField>
    <errorMessage>Renewal Date cannot be before Issue Date</errorMessage>
</ValidationRule>
