<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_BSB_Required_Retail</fullName>
    <active>true</active>
    <errorConditionFormula>AND($RecordType.DeveloperName = &quot;Retail_Banking&quot;, ISBLANK(BSB_Number__c))</errorConditionFormula>
    <errorDisplayField>BSB_Number__c</errorDisplayField>
    <errorMessage>BSB Number is required for the Retail Banking record type.</errorMessage>
</ValidationRule>
