<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Harvest_Date_Not_Future</fullName>
    <active>true</active>
    <description>Harvest Date cannot be in the future.</description>
    <errorConditionFormula>AND(
NOT(ISBLANK(Harvest_Date__c)),
Harvest_Date__c &gt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Harvest_Date__c</errorDisplayField>
    <errorMessage>Harvest Date cannot be in the future.</errorMessage>
</ValidationRule>
