<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_EndDate_GTE_StartDate</fullName>
    <active>true</active>
    <description>End Date must be on or after Start Date</description>
    <errorConditionFormula>AND(NOT(ISBLANK(End_Date__c)), NOT(ISBLANK(Start_Date__c)), End_Date__c &lt; Start_Date__c)</errorConditionFormula>
    <errorMessage>End Date must be on or after Start Date.</errorMessage>
</ValidationRule>
