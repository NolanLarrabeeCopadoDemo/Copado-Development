<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Active_Required_Fields</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Active&quot;), OR(ISBLANK(Branch_Name__c), ISPICKVAL(Account_Type__c, &quot;&quot;)))</errorConditionFormula>
    <errorMessage>Branch Name and Account Type are required when Status is Active.</errorMessage>
</ValidationRule>
