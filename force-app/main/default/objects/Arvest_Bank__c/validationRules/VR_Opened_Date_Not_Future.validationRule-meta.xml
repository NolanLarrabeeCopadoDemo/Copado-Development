<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Opened_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Opened_Date__c)), Opened_Date__c &gt; TODAY())</errorConditionFormula>
    <errorDisplayField>Opened_Date__c</errorDisplayField>
    <errorMessage>Opened Date cannot be in the future.</errorMessage>
</ValidationRule>
