<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Tournament_Name_Required</fullName>
    <active>true</active>
    <description>Tournament Name is required on Tournament Event record type.</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Tournament_Event&quot;,
    ISBLANK(Tournament_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Tournament_Name__c</errorDisplayField>
    <errorMessage>Tournament Name is required for Tournament Event records.</errorMessage>
</ValidationRule>
