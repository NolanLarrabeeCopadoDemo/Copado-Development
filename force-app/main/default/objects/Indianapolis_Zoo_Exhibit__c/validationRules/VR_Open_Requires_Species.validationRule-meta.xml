<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Open_Requires_Species</fullName>
    <active>true</active>
    <description>Species Name is required when Exhibit Status is Open.</description>
    <errorConditionFormula>AND(
ISPICKVAL(Exhibit_Status__c, &quot;Open&quot;),
ISBLANK(Species_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Species_Name__c</errorDisplayField>
    <errorMessage>Species Name is required when Exhibit Status is Open.</errorMessage>
</ValidationRule>
