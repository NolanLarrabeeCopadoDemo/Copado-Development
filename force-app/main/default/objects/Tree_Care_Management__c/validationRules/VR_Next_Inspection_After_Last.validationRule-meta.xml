<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Next_Inspection_After_Last</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Next_Inspection_Date__c)), NOT(ISBLANK(Last_Inspection_Date__c)), Next_Inspection_Date__c &lt;= Last_Inspection_Date__c)</errorConditionFormula>
    <errorMessage>Next Inspection Date must be after the Last Inspection Date.</errorMessage>
</ValidationRule>
