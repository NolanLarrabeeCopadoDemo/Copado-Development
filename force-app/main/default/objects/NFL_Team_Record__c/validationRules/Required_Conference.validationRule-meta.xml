<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Conference</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Active__c = TRUE, ISPICKVAL(Conference__c, &quot;&quot;))</errorConditionFormula>
    <errorDisplayField>Conference__c</errorDisplayField>
    <errorMessage>Conference is required when the team is Active.</errorMessage>
</ValidationRule>
