<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Team_Code_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Team_Code__c, &quot;[A-Z]{2,3}&quot;))</errorConditionFormula>
    <errorDisplayField>Team_Code__c</errorDisplayField>
    <errorMessage>Team Code must be 2 to 3 uppercase letters (e.g., NE, SF, GB).</errorMessage>
</ValidationRule>
