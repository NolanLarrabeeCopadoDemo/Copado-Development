<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Division</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Active__c = TRUE, ISPICKVAL(Division__c, &quot;&quot;))</errorConditionFormula>
    <errorDisplayField>Division__c</errorDisplayField>
    <errorMessage>Division is required when the team is Active.</errorMessage>
</ValidationRule>
