<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Service_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Service_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Service_Date__c</errorDisplayField>
    <errorMessage>Service Date cannot be later than today.</errorMessage>
</ValidationRule>
