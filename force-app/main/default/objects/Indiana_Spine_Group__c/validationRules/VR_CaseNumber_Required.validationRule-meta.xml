<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_CaseNumber_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Active&apos;), ISBLANK(Case_Number__c))</errorConditionFormula>
    <errorMessage>Case Number is required when Status is Active.</errorMessage>
</ValidationRule>
