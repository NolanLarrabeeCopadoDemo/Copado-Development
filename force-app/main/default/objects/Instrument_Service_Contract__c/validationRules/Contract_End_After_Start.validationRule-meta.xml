<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contract_End_After_Start</fullName>
    <active>true</active>
    <description>Contract End Date must be after Contract Start Date</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Contract_Start_Date__c)),
    NOT(ISBLANK(Contract_End_Date__c)),
    Contract_End_Date__c &lt;= Contract_Start_Date__c
)</errorConditionFormula>
    <errorDisplayField>Contract_End_Date__c</errorDisplayField>
    <errorMessage>Contract End Date must be after Contract Start Date</errorMessage>
</ValidationRule>
