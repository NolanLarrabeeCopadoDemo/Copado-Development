<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Percentage_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Completion_Percentage__c &lt; 0, Completion_Percentage__c &gt; 100)</errorConditionFormula>
    <errorDisplayField>Completion_Percentage__c</errorDisplayField>
    <errorMessage>Completion Percentage must be a value between 0 and 100.</errorMessage>
</ValidationRule>
