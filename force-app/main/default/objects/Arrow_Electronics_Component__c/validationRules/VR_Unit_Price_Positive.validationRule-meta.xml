<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Unit_Price_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Unit_Price__c)), Unit_Price__c &lt;= 0)</errorConditionFormula>
    <errorMessage>Unit Price must be greater than zero when populated.</errorMessage>
</ValidationRule>
