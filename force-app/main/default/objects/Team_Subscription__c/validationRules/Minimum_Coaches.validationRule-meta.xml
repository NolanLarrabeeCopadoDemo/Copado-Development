<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minimum_Coaches</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Number_of_Coaches__c)),
    Number_of_Coaches__c &lt; 1
)</errorConditionFormula>
    <errorDisplayField>Number_of_Coaches__c</errorDisplayField>
    <errorMessage>At least one coach must be assigned</errorMessage>
</ValidationRule>
