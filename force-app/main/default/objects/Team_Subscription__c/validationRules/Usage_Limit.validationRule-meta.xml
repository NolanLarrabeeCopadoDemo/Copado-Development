<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Usage_Limit</fullName>
    <active>true</active>
    <errorConditionFormula>Current_Storage_Usage__c &gt; Video_Storage_Quota__c</errorConditionFormula>
    <errorDisplayField>Current_Storage_Usage__c</errorDisplayField>
    <errorMessage>Current usage cannot exceed storage quota</errorMessage>
</ValidationRule>
