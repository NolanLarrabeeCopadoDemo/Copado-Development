<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Onboarding_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Onboarding_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Onboarding_Date__c</errorDisplayField>
    <errorMessage>Onboarding date cannot be in the future.</errorMessage>
</ValidationRule>
