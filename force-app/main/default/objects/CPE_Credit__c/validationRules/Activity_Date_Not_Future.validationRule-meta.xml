<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Activity_Date_Not_Future</fullName>
    <active>true</active>
    <description>Ensures Activity Date is not in the future</description>
    <errorConditionFormula>Activity_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Activity_Date__c</errorDisplayField>
    <errorMessage>Activity Date cannot be in the future</errorMessage>
</ValidationRule>
