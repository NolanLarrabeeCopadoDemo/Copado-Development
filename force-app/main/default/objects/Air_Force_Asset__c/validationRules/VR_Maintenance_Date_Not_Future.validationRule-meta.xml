<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Maintenance_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Last_Maintenance_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Last_Maintenance_Date__c</errorDisplayField>
    <errorMessage>Last Maintenance Date cannot be in the future.</errorMessage>
</ValidationRule>
